# Database Configuration
POSTGRES_DB=resihub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5433

# Application Backend
PORT=5000
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5433/resihub
APP_DATABASE_URL=postgres://resihub_app:resihub_app_secret@localhost:5433/resihub

# Security & Tokens
JWT_SECRET=resihub_dev_jwt_secret_key_very_secure_12345
JWT_REFRESH_SECRET=resihub_dev_jwt_refresh_secret_key_very_secure_67890
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# VietQR.io API Credentials (https://api.vietqr.io/v2/banks)
VIETQR_CLIENT_ID=
VIETQR_API_KEY=

# Frontend Configuration
VITE_API_URL=http://localhost:5000

# Idempotency-Key Guard (PRD Mục 14.3):
# Mặc định BẮT BUỘC khi NODE_ENV=production; mặc định tắt ở development/test trừ khi đặt REQUIRE_IDEMPOTENCY_KEY=true
# REQUIRE_IDEMPOTENCY_KEY=true
