# ==============================================================================
# ResiHub Production Environment Configuration (.env.production)
# Copy sang .env.production trên VPS: cp .env.production.example .env.production
# Sinh khóa ngẫu nhiên an toàn bằng lệnh: openssl rand -hex 32
# LƯU Ý: Chỉ dùng ký tự hex/chữ-số cho mật khẩu CSDL để không làm vỡ chuỗi URI
# ==============================================================================

# --- 1. Tên miền & Mạng đảo ngược (Caddy 2) ---
# Chạy bằng IP trần qua HTTP cổng 80 ngay lập tức: giữ APP_DOMAIN=:80
# Khi có tên miền (VD: resihub.duckdns.org hoặc quanly.tenmien.vn): điền tên miền không kèm https://
APP_DOMAIN=:80
# Khi chạy cùng origin qua Caddy thì để trống; khi có HTTPS điền: https://tenmien.vn
CORS_ORIGIN=

# --- 2. Cơ sở dữ liệu PostgreSQL & Tách quyền RLS (BẮT BUỘC ĐỔI TRÊN VPS) ---
POSTGRES_DB=resihub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
APP_DB_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# --- 3. Khóa ký JWT (BẮT BUỘC ĐỔI TRÊN VPS) ---
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# --- 4. Khởi tạo Tổ chức & Tài khoản SYS_ADMIN lần đầu (Idempotent) ---
INIT_ORG_NAME="Ban Quản Lý Tòa Nhà ResiHub"
INIT_ADMIN_EMAIL=admin@resihub.vn
INIT_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
INIT_ADMIN_PHONE=0900000001

# --- 5. Chế độ Trình diễn (Demo UI & OTP trên VPS) ---
# Bật/tắt tức thì bằng: ./deploy/demo-mode.sh on | off | status (không cần build lại Frontend)
SHOW_DEMO_ACCOUNTS=false
# Khi chưa tích hợp cổng SMS/Email thật, có thể bật true tạm thời để kiểm thử luồng OTP
OTP_DEMO_MODE=false
# Chỉ chạy seed Vinhomes (3 tòa, 240 căn hộ) khi CSDL hoàn toàn trống ở lần khởi động đầu tiên
SEED_DEMO_ON_FIRST_BOOT=false

# --- 6. Sao lưu tự động (02:00 sáng hàng ngày giờ Việt Nam) ---
BACKUP_RETENTION_DAYS=30

# --- 7. Tích hợp bên thứ ba (Tùy chọn) ---
VIETQR_CLIENT_ID=
VIETQR_API_KEY=
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_MS=45000
